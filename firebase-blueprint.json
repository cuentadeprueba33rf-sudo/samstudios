{
  "entities": {
    "Movie": {
      "title": "Movie",
      "description": "A movie in the catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "year": { "type": "string" },
        "genre": { "type": "array", "items": { "type": "string" } },
        "posterUrl": { "type": "string" },
        "streamUrl": { "type": "string" },
        "rating": { "type": "number" },
        "director": { "type": "string" },
        "actors": { "type": "array", "items": { "type": "string" } },
        "imdbId": { "type": "string" },
        "trendingRank": { "type": "number" },
        "isDirectLink": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "description", "year", "genre", "posterUrl", "streamUrl", "rating"]
    },
    "Actor": {
      "title": "Actor",
      "description": "An actor in the catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "character": { "type": "string" },
        "movie": { "type": "string" },
        "image": { "type": "string" },
        "award": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "character", "movie", "image"]
    },
    "Request": {
      "title": "Request",
      "description": "A content request from a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["Película", "Serie"] },
        "note": { "type": "string" },
        "userEmail": { "type": "string" },
        "userId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed", "rejected"] },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "type", "userId", "status", "created_at"]
    },
    "Notification": {
      "title": "Notification",
      "description": "A notification for a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["request_accepted", "info"] },
        "read": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "message", "type", "read", "created_at"]
    }
  },
  "firestore": {
    "/movies/{movieId}": {
      "schema": { "$ref": "#/entities/Movie" },
      "description": "Movies collection"
    },
    "/actors/{actorId}": {
      "schema": { "$ref": "#/entities/Actor" },
      "description": "Actors collection"
    },
    "/requests/{requestId}": {
      "schema": { "$ref": "#/entities/Request" },
      "description": "User content requests"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User notifications"
    }
  }
}
